POSTGRES_DB=benchmark
POSTGRES_USER=benchmark
POSTGRES_PASSWORD=benchmark

SESSION_SECRET=change-me-to-a-long-random-string

OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API=
ANTHROPIC_API_KEY=
# Gemini: create at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Mistral Agents (beta): when set, adds "Mistral Agent (beta)" to the run picker
# (wire id mistral-agent:<this value>). Uses the same MISTRAL_API_KEY as chat.
MISTRAL_AGENT_ID=
MISTRAL_AGENT_VERSION=0

# Local models via Ollama (optional). Installed models show up in the run
# dialog under "Local (Ollama)"; the Admin page shows what is installed.
# Where Ollama runs decides the address:
#   - no Docker (uvicorn on the host):   http://localhost:11434   (the default)
#   - app in Docker, Ollama on the host: http://host.docker.internal:11434
#                                        (leave empty; docker-compose.yml uses it)
#   - Ollama in Compose (--profile local): http://ollama:11434
OLLAMA_BASE_URL=
# Seconds to wait for one Ollama answer. The first request loads the model.
OLLAMA_TIMEOUT_S=600

SEED_ADMIN_USERNAME=admin
# Must be at least 8 characters. Leave unset and the app falls back to a
# dev-only default (see src/web/seed.py) and logs a warning on boot.
SEED_ADMIN_PASSWORD=
# Set to 1 to also seed demo "mateo" (author) + "jarod" (reviewer) users.
SEED_DEMO_USERS=1
# Same dev-only-default-with-warning behavior as SEED_ADMIN_PASSWORD above.
SEED_MATEO_PASSWORD=
SEED_JAROD_PASSWORD=
